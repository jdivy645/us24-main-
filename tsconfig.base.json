{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,

    // Workspace packages are consumed as TypeScript source (their `main` points
    // at src/index.ts), so no declaration emit or project references are needed.
    // Vite, Vitest and tsx each transpile directly. apps/api is the only package
    // that emits JavaScript, and it does so from its own tsconfig.
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}
