{
  "name": "@us24/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API. Deterministic verification, versioned revisions, SSE processing events and status-gated document generation.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --noEmit -p tsconfig.build.json && node build.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx src/db/migrate.ts",
    "seed": "tsx src/services/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@us24/domain": "workspace:*",
    "@us24/schemas": "workspace:*",
    "@us24/testing": "workspace:*",
    "fastify": "5.11.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.10",
    "esbuild": "0.28.1",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
